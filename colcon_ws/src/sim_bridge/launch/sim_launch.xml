<launch>
    <arg name="vision" default="true" />
    <arg name="ekf" default="true" />

    <group if="$(var ekf)">
      <arg name="q_imunominalup_imuup_w" default="1.0" />
      <arg name="q_imunominalup_imuup_x" default="0.0" />
      <arg name="q_imunominalup_imuup_y" default="0.0" />
      <arg name="q_imunominalup_imuup_z" default="0.0" />

      <arg name="q_dvlnominalup_dvlup_w" default="1.0" />
      <arg name="q_dvlnominalup_dvlup_x" default="0.0" />
      <arg name="q_dvlnominalup_dvlup_y" default="0.0" />
      <arg name="q_dvlnominalup_dvlup_z" default="0.0" />

      <arg name="auv_dvl_offset_x" default="0.0" />
      <arg name="auv_dvl_offset_y" default="0.0" />
      <arg name="auv_dvl_offset_z" default="0.0" />

      <node name="dvl_transform_pub" pkg="tf2_ros" exec="static_transform_publisher" args="$(var auv_dvl_offset_x) $(var auv_dvl_offset_y) $(var auv_dvl_offset_z) 
        $(var q_dvlnominalup_dvlup_x) $(var q_dvlnominalup_dvlup_y) $(var q_dvlnominalup_dvlup_z) $(var q_dvlnominalup_dvlup_w) 
        auv dvl">
        <param name="use_sim_time" value="true" />
        <param name="q_dvlnominalup_dvlup_w" value="$(var q_dvlnominalup_dvlup_w)" />
        <param name="q_dvlnominalup_dvlup_x" value="$(var q_dvlnominalup_dvlup_x)" />
        <param name="q_dvlnominalup_dvlup_y" value="$(var q_dvlnominalup_dvlup_y)" />
        <param name="q_dvlnominalup_dvlup_z" value="$(var q_dvlnominalup_dvlup_z)" />

        <param name="auv_dvl_offset_x" value="$(var auv_dvl_offset_x)" />
        <param name="auv_dvl_offset_y" value="$(var auv_dvl_offset_y)" />
        <param name="auv_dvl_offset_z" value="$(var auv_dvl_offset_z)" />
      </node>

      <node name="imu_transform_pub" pkg="tf2_ros" exec="static_transform_publisher" args="0 0 0 
        $(var q_imunominalup_imuup_x) $(var q_imunominalup_imuup_y) $(var q_imunominalup_imuup_z) $(var q_imunominalup_imuup_w) 
        auv imu">
        <param name="use_sim_time" value="true" />
        <param name="q_imunominalup_imuup_w" value="$(var q_imunominalup_imuup_w)" />
        <param name="q_imunominalup_imuup_x" value="$(var q_imunominalup_imuup_x)" />
        <param name="q_imunominalup_imuup_y" value="$(var q_imunominalup_imuup_y)" />
        <param name="q_imunominalup_imuup_z" value="$(var q_imunominalup_imuup_z)" />
      </node>
        
      <node pkg="tf2_ros" exec="static_transform_publisher" name="depth_transform_pub" args="0 0 0 0 0 0 1 auv depth" >
        <param name="use_sim_time" value="true" />
      </node>  
    </group>

    <include file="$(find bringup)/launch/bringup.launch">
        <arg name="sim" value="true" />
        <arg name="vision" value="$(var vision)" />
        <arg name="ekf" value="$(var ekf)" />
    </include>

    <include file="$(find-pkg-share sim)/launch/endpoint_launch.xml"></include>

    <node name="unity_bridge" pkg="sim" exec="unity_bridge.py" output="screen">
        <param name="use_sim_time" value="true" />
        <param name="ekf" value="$(var ekf)" />
    </node>
</launch>
