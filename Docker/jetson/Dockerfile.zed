# Base Image
FROM stereolabs/zed:4.2-tools-devel-l4t-r36.4

# Set Non-Interactive Mode for APT
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8

# Add ROS 2 Repository & Install ROS Tools
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null && \
  apt update

#install Required Dependencies in a Single Step and improved caching
RUN apt-get update && apt-get install -y \
  curl \
  locales \
  python3-pip \
  python3-colcon-common-extensions \            
  python3-flake8-docstrings \
  python3-flake8-blind-except \
  python3-flake8-builtins \
  python3-flake8-class-newline \
  python3-flake8-comprehensions \
  python3-flake8-deprecated \
  python3-flake8-import-order \
  python3-flake8-quotes \
  python3-pytest-cov \
  python3-pytest-repeat \
  python3-pytest-rerunfailures \
  ros-humble-desktop-full \                       
  ros-humble-robot-localization \
  ros-humble-point-cloud-transport \
  && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

# Create workspace
WORKDIR /root/ros2_ws/src

# Download specific release of zed-ros2-wrapper (stable, ROS2 Humble compatible)
RUN curl -L https://github.com/stereolabs/zed-ros2-wrapper/archive/refs/tags/humble-v4.2.x.tar.gz -o zed-ros2-wrapper.tar.gz && \
  tar -xzf zed-ros2-wrapper.tar.gz && \
  mv zed-ros2-wrapper-humble-v4.2.x zed-ros2-wrapper && \
  rm zed-ros2-wrapper.tar.gz

# Clone other ROS 2 packages
RUN git clone https://github.com/ros-drivers/nmea_msgs.git && \
  git clone -b ros2 https://github.com/ros-geographic-info/geographic_info.git && \
  git clone -b humble https://github.com/stereolabs/zed-ros2-interfaces.git && \
  git clone --recursive https://github.com/majdkhalife/cob_common.git

# Install Dependencies Using rosdep
WORKDIR /root/ros2_ws
RUN apt update && rosdep init && rosdep update && \
  rosdep install --from-paths src --ignore-src -r -y && \
  rm -rf /var/lib/apt/lists/*

#this would fail if ros2 repos changed or some dependencies changed
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
  colcon build --parallel-workers $(nproc) --symlink-install \
  --event-handlers console_direct+ --base-paths src \
  --cmake-args ' -DCMAKE_BUILD_TYPE=Release' \
  ' -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs' \
  ' -DCMAKE_CXX_FLAGS=\"-Wl,--allow-shlib-undefined\"' \
  ' --no-warn-unused-cli'"

#create New User for Jetson, tag ensures dockerfile keeps working regardless of any changes in base img
RUN adduser jetson --disabled-password --gecos "" 

#download & Install ZED SDK (Move this Down Since It’s a Big File)
WORKDIR /root/
RUN wget https://stereolabs.sfo2.cdn.digitaloceanspaces.com/zedsdk/4.2/ZED_SDK_Tegra_L4T36.4_v4.2.3.zstd.run && \
  chmod +x ZED_SDK_Tegra_L4T36.4_v4.2.3.zstd.run

#run ZED Installer as Root (Safer) Then Change Ownership
RUN ./ZED_SDK_Tegra_L4T36.4_v4.2.3.zstd.run -- silent && \
  chown -R jetson:jetson /usr/local/zed

#keep Container Running (Change if You Need a Different Entry Point)
CMD ["bash", "-c", "tail -f /dev/null"]
