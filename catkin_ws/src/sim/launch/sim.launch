<launch>
  <param name="/use_sim_time" value="true" />

  <arg name="vision" default="true" />
  <arg name="ekf" default="true" />

  <!-- Parameters required by unity_bridge.py -->
    <!-- TODO: Replace with the actual offsets nd rotations based on how sensors are mounted -->
  <param name="q_dvlnominalup_dvlup_w" value="1.0" />
  <param name="q_dvlnominalup_dvlup_x" value="0.0" />
  <param name="q_dvlnominalup_dvlup_y" value="0.0" />
  <param name="q_dvlnominalup_dvlup_z" value="0.0" />

  <param name="q_imunominalup_imuup_w" value="1.0" />
  <param name="q_imunominalup_imuup_x" value="0.0" />
  <param name="q_imunominalup_imuup_y" value="0.0" />
  <param name="q_imunominalup_imuup_z" value="0.0" />

  <!-- Unity bridge node -->
  <node name="unity_bridge" pkg="sim" type="unity_bridge.py" output="screen">
    <param name="ekf" value="$(arg ekf)" />
  </node>

  <!-- Simulation bringup -->
  <include file="$(find bringup)/launch/bringup.launch">
    <arg name="sim" value="true" />
    <arg name="vision" value="$(arg vision)" />
    <arg name="ekf" value="$(arg ekf)" />
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_broadcaster" args="0 0 0 0 0 0 auv camera" />

  <!-- Simulation-specific endpoint logic -->
  <include file="$(find sim)/launch/endpoint.launch" />
</launch>
