<launch>
  <!-- Launch arguments -->
  <arg name="sim" default="false" />
  <arg name="ekf" default="true" />

  <!-- General parameters, TODO: See if these are used somewhere. if not, remove them -->  
  <param name="update_rate" value="100" />
  <param name="z_pos_mount_offset" value="0" />
  <param name="sensor_swap_warning_interval" value="5" />

  <!-- === Static Transform Configuration === -->

  <!-- === Quaternion from nominal-up to imu-up === -->
  <!-- ENU: Quaternion (qx, qy, qz, qw) rotation from AUV frame to IMU frame -->
  <arg name="q_imunominalup_imuup_w" default="1.0" />
  <arg name="q_imunominalup_imuup_x" default="0.0" />
  <arg name="q_imunominalup_imuup_y" default="0.0" />
  <arg name="q_imunominalup_imuup_z" default="0.0" />

  <!-- === Quaternion from nominal-up to dvl-up === -->
  <!-- ENU: Quaternion (qx, qy, qz, qw) rotation from AUV frame to DVL frame -->
  <arg name="q_dvlnominalup_dvlup_w" default="1.0" />
  <arg name="q_dvlnominalup_dvlup_x" default="0.0" />
  <arg name="q_dvlnominalup_dvlup_y" default="0.0" />
  <arg name="q_dvlnominalup_dvlup_z" default="0.0" />

  <!-- === AUV to DVL translation offset === -->
  <!-- ENU: Translation (x, y, z) from AUV frame to DVL [meters] -->
  <arg name="auv_dvl_offset_x" default="0.093869" />
  <arg name="auv_dvl_offset_y" default="-0.068498" />
  <arg name="auv_dvl_offset_z" default="-0.118676" />

  <!-- === AUV to IMU translation offset === -->
  <!-- ENU: Translation (x, y, z) from AUV frame to IMU [meters] -->
  <arg name="auv_imu_offset_x" default="0.14527" /> 
  <arg name="auv_imu_offset_y" default="0.0077" /> 
  <arg name="auv_imu_offset_z" default="0.039609" /> 

  <!-- === AUV to Depth Sensor translation offset === -->
  <!-- ENU: Translation (x, y, z) from AUV frame to Depth Sensor [meters] -->
  <arg name="auv_depth_offset_x" default="-0.061307" />
  <arg name="auv_depth_offset_y" default="-0.058551307" />
  <arg name="auv_depth_offset_z" default="-0.088731" />

  <!-- === AUV to Zed2i translation offset === -->
  <!-- ENU: Translation (x, y, z) from AUV frame to Zed2i [meters] -->
  <arg name="auv_zed_offset_x" default="0.15141" />
  <arg name="auv_zed_offset_y" default="0.0" />
  <arg name="auv_zed_offset_z" default="-0.016386" />

  <!-- === Static transform publishers for sensor frames === -->

<group unless="$(arg sim)"> <!-- Use real world offets -->
  <!-- DVL: Transform from AUV to DVL frame -->
  <!-- ENU: Translation and quaternion define DVL frame in AUV coordinates -->
  <node name="dvl_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="$(arg auv_dvl_offset_x) $(arg auv_dvl_offset_y) $(arg auv_dvl_offset_z)
              $(arg q_dvlnominalup_dvlup_x) $(arg q_dvlnominalup_dvlup_y) $(arg q_dvlnominalup_dvlup_z) $(arg q_dvlnominalup_dvlup_w)
              auv dvl" />

  <!-- IMU: Transform from AUV to IMU frame -->
  <!-- ENU: Translation and quaternion define IMU frame in AUV coordinates -->
  <node name="imu_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="$(arg auv_imu_offset_x) $(arg auv_imu_offset_y) $(arg auv_imu_offset_z)
              $(arg q_imunominalup_imuup_x) $(arg q_imunominalup_imuup_y) $(arg q_imunominalup_imuup_z) $(arg q_imunominalup_imuup_w)
              auv imu" />

  <!-- Depth Sensor: Transform from AUV to Depth frame -->
  <!-- ENU: Translation only (no rotation), assumes aligned with AUV frame -->
  <node name="depth_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="$(arg auv_depth_offset_x) $(arg auv_depth_offset_y) $(arg auv_depth_offset_z)
              0 0 0 1
              auv depth" />

  <node name="zed_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="$(arg auv_zed_offset_x) $(arg auv_zed_offset_y) $(arg auv_zed_offset_z)
              0 0 0 1
              auv zed" />
  </group>


<group if="$(arg sim)">
  <!-- DVL: Transform from AUV to DVL frame -->
  <!-- ENU: Translation and quaternion define DVL frame in AUV coordinates -->
  <node name="dvl_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0
              $(arg q_dvlnominalup_dvlup_x) $(arg q_dvlnominalup_dvlup_y) $(arg q_dvlnominalup_dvlup_z) $(arg q_dvlnominalup_dvlup_w)
              auv dvl" />

  <!-- IMU: Transform from AUV to IMU frame -->
  <!-- ENU: Translation and quaternion define IMU frame in AUV coordinates -->
  <node name="imu_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0
              $(arg q_imunominalup_imuup_x) $(arg q_imunominalup_imuup_y) $(arg q_imunominalup_imuup_z) $(arg q_imunominalup_imuup_w)
              auv imu" />

  <!-- Depth Sensor: Transform from AUV to Depth frame -->
  <!-- ENU: Translation only (no rotation), assumes aligned with AUV frame -->
  <node name="depth_transform_pub" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 0
              0 0 0 1
              auv depth" />
  </group>

  <!-- === EKF and Clock Management === -->

<param name="update_state_on_clock" value="$(arg sim)" />

<group if="$(arg ekf)">
  <group if="$(arg sim)">
    <include file="$(find state_estimation)/launch/test_localization.launch">
      <arg name="remove_gravity" value="false" />
      <arg name="sim" value="true" />
    </include>
  </group>
  <group unless="$(arg sim)">
    <include file="$(find state_estimation)/launch/test_localization.launch">
      <arg name="remove_gravity" value="false" />
      <arg name="sim" value="false" />
    </include>
  </group>
</group>


</launch>