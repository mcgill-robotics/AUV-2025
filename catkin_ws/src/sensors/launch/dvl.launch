<launch>
  <!-- Waterlinked DVL driver with dynamic covariance -->
  <arg name="port" default="/dev/ttyUSB0"/>
  <arg name="baudrate" default="115200"/>
  <arg name="quat_variance" default="0.01"/>

  <node pkg="sensors" type="dvl_covariance.py" name="dvl_covariance_driver" output="screen">
    <param name="port" value="$(arg port)" />
    <param name="baudrate" value="$(arg baudrate)" />
    <param name="quat_variance" value="$(arg quat_variance)" />
  </node>
</launch>
